# OpenAI API Key for natural language to SQL conversion
# 阿里云百炼 API Key (在 https://bailian.console.aliyun.com/ 获取)
OPENAI_API_KEY=sk-f487f41xxxxxxxxxxxxxxxxxxxxxxxxx

# 阿里云百炼 API 地址
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 阿里云百炼模型名称 (可选: qwen-turbo, qwen-plus, qwen-max)
NL2SQL_MODEL=qwen3.7-max-preview

# Optional: Custom data directory (defaults to ~/.db_query)
DB_QUERY_DATA_DIR=~/.db_query

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# CORS origins (comma-separated, * for all)
CORS_ORIGINS=*
